{
  "compilerOptions": {
    "declaration": true,
    "esModuleInterop": true,
    "lib": [
      "es2018"
    ],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "target": "es2015"
  },
  "include": [
    "./src/*.ts"
  ],
  "exclude": [
    "./src/*.test.ts"
  ]
}
